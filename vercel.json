{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "loco-pilot.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "https://national-rail-command-main.onrender.com/api/$1" },
    { "src": "/loco-pilot.html", "dest": "/loco-pilot.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
